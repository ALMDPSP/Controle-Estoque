templates/historico.html:2:</head><body><header><span class="tag">AUDITORIA</span><h1>Histórico de movimentações</h1><p>Rastreie quem fez cada entrada, edição, saída, exclusão ou restauração.</p></header>{% include '_menu.html' %}<main><section class="panel"><div class="tools"><input id="q" placeholder="Filtrar por código, descrição, usuário ou observação"><select id="origem"><option value="">Todas as origens</option><option value="itens">Estoque</option><option value="imobilizados">Imobilizados</option><option value="sistema">Sistema</option></select><select id="tipo"><option value="">Todos os tipos</option></select><input type="date" id="inicio"><input type="date" id="fim"><button id="imprimir" style="background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:9px 11px;color:var(--text);cursor:pointer">Imprimir / PDF</button></div><div class="table-wrap"><table><thead><tr><th>Data/hora</th><th>Origem</th><th>Item</th><th>Tipo</th><th>Qtd.</th><th>Usuário</th><th>Observação</th></tr></thead><tbody id="tb"></tbody></table></div></section>{% if is_admin %}<section class="panel audit-login"><h2>Auditoria de acesso</h2><p>Últimos eventos de autenticação. Por segurança, o endereço IP não é exibido nesta tela.</p><div class="table-wrap"><table><thead><tr><th>Data/hora</th><th>Usuário</th><th>Resultado</th><th>Detalhe</th></tr></thead><tbody id="tb-login"><tr><td colspan="4" style="color:var(--muted)">Carregando auditoria...</td></tr></tbody></table></div></section>{% endif %}</main>{% include '_footer.html' %}<script>let movs=[];const norm=s=>String(s||'').toLowerCase();function render(){const q=norm(document.getElementById('q').value),o=document.getElementById('origem').value,t=document.getElementById('tipo').value,i=document.getElementById('inicio').value,f=document.getElementById('fim').value;const arr=movs.filter(m=>{const d=String(m.data_hora||'').slice(0,10);return (!o||(m.tabela||'itens')===o)&&(!t||m.tipo===t)&&(!i||d>=i)&&(!f||d<=f)&&(!q||norm(`${m.codigo} ${m.descricao} ${m.usuario} ${m.observacao} ${m.tipo}`).includes(q))});document.getElementById('tb').innerHTML=arr.map(m=>`<tr><td>${m.data_hora||''}</td><td>${m.tabela==='imobilizados'?'Imobilizados':m.tabela==='sistema'?'Sistema':'Estoque'}</td><td><code>${m.codigo||'#'+m.item_id}</code><br>${m.descricao||''}</td><td><span class="badge">${m.tipo||''}</span></td><td>${m.quantidade||''}</td><td>${m.usuario||''}</td><td>${m.observacao||''}</td></tr>`).join('')||'<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:30px">Nenhuma movimentação encontrada.</td></tr>'}fetch('/api/movimentacoes-recentes?limite=500').then(r=>r.json()).then(x=>{movs=x;const tipos=[...new Set(x.map(m=>m.tipo).filter(Boolean))].sort();document.getElementById('tipo').innerHTML='<option value="">Todos os tipos</option>'+tipos.map(t=>`<option>${t}</option>`).join('');render()});['q','origem','tipo','inicio','fim'].forEach(id=>document.getElementById(id).addEventListener('input',render));document.getElementById('imprimir').addEventListener('click',()=>window.print());{% if is_admin %}fetch('/api/auditoria-login?limite=200').then(r=>r.json()).then(eventos=>{const tb=document.getElementById('tb-login');if(!tb)return;tb.innerHTML=eventos.map(e=>{const cls=e.resultado==='sucesso'||e.resultado==='senha_alterada'?'login-ok':e.resultado==='bloqueado'?'login-block':'login-fail';const rotulo=e.resultado==='senha_alterada'?'Senha alterada':e.resultado==='sucesso'?'Sucesso':e.resultado==='bloqueado'?'Bloqueado':'Falha';return `<tr><td>${e.data_hora||''}</td><td>${e.username||'(não informado)'}</td><td><span class="badge ${cls}">${rotulo}</span></td><td>${e.motivo||''}</td></tr>`}).join('')||'<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:24px">Nenhum evento de acesso registrado.</td></tr>'}).catch(()=>{const tb=document.getElementById('tb-login');if(tb)tb.innerHTML='<tr><td colspan="4" style="color:var(--danger)">Não foi possível carregar a auditoria de acesso.</td></tr>'});{% endif %}</script></body></html>
